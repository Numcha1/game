config_version=5

[application]
config/name="Seasons Together · สวนเพลง"
run/main_scene="res://Scenes/Farm.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=800
window/size/viewport_height=450
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]
project/assembly_name="SeasonsTogether"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.11, 0.17, 0.13, 1)
