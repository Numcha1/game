<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>SuanPleng</AssemblyName><PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><DebugType>none</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="tools/cloudflared.exe" LogicalName="SuanPleng.cloudflared.exe" />
    <EmbeddedResource Include="tools/CLOUDFlARED-LICENSE.txt" LogicalName="SuanPleng.cloudflared.LICENSE" />
  </ItemGroup>
</Project>
